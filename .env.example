# Local development only; replace the password for any shared environment.
DB_USER=shortener
DB_PASSWORD=local-development-only
BASE_URL=http://localhost:8080
DB_PORT=5433
# Compose defaults to jdbc:postgresql://db:5432/shortener.
# A host-run JVM defaults to jdbc:postgresql://localhost:5433/shortener.
# Set DATABASE_URL explicitly only when using a different database.
